rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read of avatars is optional; tighten if you want private only.
    match /profile_pictures/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
