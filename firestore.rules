rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin (via custom claims)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the owner of the document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Users collection rules
    match /users/{userId} {
      // Allow authenticated users to read their own document
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow authenticated users to create their own document during signup
      allow create: if isOwner(userId);
      
      // Allow authenticated users to update their own document, but not privileged fields
      allow update: if isOwner(userId) && 
        // Ensure role and admin-related fields are not modified by non-admins
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'adminLevel']));
      
      // Allow admins to update any user document
      allow update: if isAdmin();
      
      // Allow admins to delete user documents
      allow delete: if isAdmin();
    }

    // Vendors collection rules
    match /vendors/{vendorId} {
      // Anyone authenticated can read vendor documents (for browsing)
      allow read: if isAuthenticated();
      
      // Vendors can create and manage their own vendor document
      allow create: if isOwner(vendorId);
      allow update, delete: if isOwner(vendorId) || isAdmin();
      
      // Menus subcollection
      match /menus/{menuId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(vendorId) || isAdmin();
      }
    }

    // Orders collection rules
    match /orders/{orderId} {
      // Users can read their own orders
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || 
         resource.data.vendorId == request.auth.uid ||
         isAdmin());
      
      // Users can create orders for themselves
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      
      // Vendors can update orders for their vendor
      allow update: if isAuthenticated() && 
        (resource.data.vendorId == request.auth.uid || isAdmin());
      
      // Only admins can delete orders
      allow delete: if isAdmin();
    }
  }
}
